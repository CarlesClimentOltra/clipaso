# Configuración de SmartCuts (API + worker). Copia este fichero como `.env`.
# Cualquier ajuste de src/smartcuts/infra/config.py se puede fijar con el prefijo SMARTCUTS_
# (los anidados con doble guion bajo, p. ej. SMARTCUTS_STORAGE__BACKEND).

# =============================================================================
# DESARROLLO LOCAL (valores por defecto: no hace falta nada más)
# =============================================================================
# SQLite en data/, almacenamiento en data/storage, login sin contraseña ("dev"),
# worker local con tu GPU.
SMARTCUTS_ENV=dev

# Para probar en local sin coste puedes usar tu suscripción de Claude.
# PROHIBIDO en producción (la configuración de prod lo rechaza al arrancar).
SMARTCUTS_LLM__PROVIDER=claude_cli

# =============================================================================
# PRODUCCIÓN (todo alojado en la UE)
# =============================================================================
# SMARTCUTS_ENV=prod
# SMARTCUTS_LOG_JSON=true
# SMARTCUTS_API__SECRET_KEY=<cadena aleatoria larga: python -c "import secrets;print(secrets.token_urlsafe(48))">
# SMARTCUTS_API__PUBLIC_URL=https://api.tudominio.com
# SMARTCUTS_API__WEB_ORIGINS=["https://tudominio.com"]
#
# --- Base de datos: Postgres de Supabase (región Frankfurt, eu-central-1) ---
# SMARTCUTS_DATABASE__URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# --- Autenticación: Supabase Auth ---
# SMARTCUTS_AUTH__MODE=supabase
# SMARTCUTS_AUTH__SUPABASE_URL=https://<ref>.supabase.co
#
# --- Almacenamiento: Cloudflare R2 con jurisdicción EU ---
# SMARTCUTS_STORAGE__BACKEND=r2
# SMARTCUTS_STORAGE__R2_ACCOUNT_ID=
# SMARTCUTS_STORAGE__R2_ACCESS_KEY_ID=
# SMARTCUTS_STORAGE__R2_SECRET_ACCESS_KEY=
# SMARTCUTS_STORAGE__R2_BUCKET=smartcuts
#
# --- Worker: GPU en Modal (ver README, "Worker en Modal") ---
# SMARTCUTS_WORKER__DISPATCHER=modal
# MODAL_TOKEN_ID=          # solo en servidores; en tu PC basta con `modal token new`
# MODAL_TOKEN_SECRET=
#
# --- Emails al usuario (clips listos / fallo) con Brevo ---
# SMARTCUTS_NOTIFICATIONS__PROVIDER=brevo
# SMARTCUTS_NOTIFICATIONS__BREVO_API_KEY=
# SMARTCUTS_NOTIFICATIONS__SENDER_EMAIL=   # remitente verificado en Brevo
# SMARTCUTS_NOTIFICATIONS__WEB_URL=https://tudominio.com
#
# --- IA: API de Anthropic (pago por uso) ---
# SMARTCUTS_LLM__PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# SMARTCUTS_LLM__MODEL=claude-sonnet-5
# SMARTCUTS_LLM__EFFORT=medium
# SMARTCUTS_BUDGET__MAX_USD_PER_JOB=1.50

# =============================================================================
# Ajustes opcionales
# =============================================================================
# SMARTCUTS_LOG_LEVEL=INFO
# SMARTCUTS_TRANSCRIPTION__MODEL=large-v3-turbo   # large-v3 | medium | small
# SMARTCUTS_TRANSCRIPTION__DEVICE=auto            # auto | cuda | cpu
