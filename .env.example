# Configuración de Clipaso (API + worker). Copia este fichero como `.env`.
# Cualquier ajuste de src/clipaso/infra/config.py se puede fijar con el prefijo CLIPASO_
# (los anidados con doble guion bajo, p. ej. CLIPASO_STORAGE__BACKEND).

# =============================================================================
# DESARROLLO LOCAL (valores por defecto: no hace falta nada más)
# =============================================================================
# SQLite en data/, almacenamiento en data/storage, login sin contraseña ("dev"),
# worker local con tu GPU.
CLIPASO_ENV=dev

# Para probar en local sin coste puedes usar tu suscripción de Claude.
# PROHIBIDO en producción (la configuración de prod lo rechaza al arrancar).
CLIPASO_LLM__PROVIDER=claude_cli

# =============================================================================
# PRODUCCIÓN (todo alojado en la UE)
# =============================================================================
# CLIPASO_ENV=prod
# CLIPASO_LOG_JSON=true
# CLIPASO_API__SECRET_KEY=<cadena aleatoria larga: python -c "import secrets;print(secrets.token_urlsafe(48))">
# CLIPASO_API__PUBLIC_URL=https://api.tudominio.com
# CLIPASO_API__WEB_ORIGINS=["https://tudominio.com"]
#
# --- Base de datos: Postgres de Supabase (región Frankfurt, eu-central-1) ---
# CLIPASO_DATABASE__URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# --- Autenticación: Supabase Auth ---
# CLIPASO_AUTH__MODE=supabase
# CLIPASO_AUTH__SUPABASE_URL=https://<ref>.supabase.co
#
# --- Almacenamiento: Cloudflare R2 con jurisdicción EU ---
# CLIPASO_STORAGE__BACKEND=r2
# CLIPASO_STORAGE__R2_ACCOUNT_ID=
# CLIPASO_STORAGE__R2_ACCESS_KEY_ID=
# CLIPASO_STORAGE__R2_SECRET_ACCESS_KEY=
# CLIPASO_STORAGE__R2_BUCKET=clipaso
#
# --- Worker: GPU en Modal (ver README, "Worker en Modal") ---
# CLIPASO_WORKER__DISPATCHER=modal
# MODAL_TOKEN_ID=          # solo en servidores; en tu PC basta con `modal token new`
# MODAL_TOKEN_SECRET=
#
# --- Emails al usuario (clips listos / fallo) con Brevo ---
# CLIPASO_NOTIFICATIONS__PROVIDER=brevo
# CLIPASO_NOTIFICATIONS__BREVO_API_KEY=
# CLIPASO_NOTIFICATIONS__SENDER_EMAIL=   # remitente verificado en Brevo
# CLIPASO_NOTIFICATIONS__WEB_URL=https://tudominio.com
#
# --- IA: API de Anthropic (pago por uso) ---
# CLIPASO_LLM__PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CLIPASO_LLM__MODEL=claude-sonnet-5
# CLIPASO_LLM__EFFORT=medium
# CLIPASO_BUDGET__MAX_USD_PER_JOB=1.50

# =============================================================================
# Ajustes opcionales
# =============================================================================
# CLIPASO_LOG_LEVEL=INFO
# CLIPASO_TRANSCRIPTION__MODEL=large-v3-turbo   # large-v3 | medium | small
# CLIPASO_TRANSCRIPTION__DEVICE=auto            # auto | cuda | cpu
