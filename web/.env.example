# Copia como .env.local (desarrollo) o define estas variables en Vercel (producción).
NEXT_PUBLIC_API_URL=http://localhost:8000
# dev (login sin contraseña contra la API local) | supabase
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "true" cuando Google esté activado como proveedor en Supabase (Authentication → Sign In / Providers)
NEXT_PUBLIC_AUTH_GOOGLE=
# Clave pública (site key) de Cloudflare Turnstile; vacío = sin captcha
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
